{
	"extends": "@wordpress/stylelint-config",
	"rules": {
		"no-descending-specificity": null,
		"selector-class-pattern": [
			"^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
			{ "message": "Use lowercase BEM-style classes (block__element--modifier)." }
		]
	}
}
